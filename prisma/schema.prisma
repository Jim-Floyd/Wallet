generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id  // Supabase auth.users UUID
  email         String?   @unique
  phone         String?   @unique
  name          String?
  avatarUrl     String?
  locale        String    @default("uz")
  currency      String    @default("UZS")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallets       Wallet[]
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  goals         Goal[]
  debts         Debt[]
  recurringRules RecurringRule[]
  referrals     Referral[]    @relation("referrer")
  referredBy    Referral?     @relation("referred")
}

model Wallet {
  id           String          @id @default(cuid())
  userId       String
  name         String
  balance      Decimal         @default(0) @db.Decimal(15, 2)
  currency     String          @default("UZS")
  kind         WalletKind      @default(DEBIT)
  creditLimit  Decimal?        @db.Decimal(15, 2) // faqat CREDIT; qoldiq manfiy — ishlatilgan qarz
  cardNumber   String?
  color        String?
  icon         String?
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromTransactions Transaction[] @relation("fromWallet")
  toTransactions   Transaction[] @relation("toWallet")
  recurringRules   RecurringRule[]
}

// DEBIT — o'z puli (naqd, plastik). CREDIT — kredit karta/liniya: qoldiq 0 dan pastga tushadi,
// manfiy qoldiq = bank oldidagi qarz, mavjud mablag' = creditLimit + balance
enum WalletKind {
  DEBIT
  CREDIT
}

model Transaction {
  id           String          @id @default(cuid())
  userId       String
  walletId     String
  toWalletId   String?
  type         TransactionType
  amount       Decimal         @db.Decimal(15, 2)
  currency     String          @default("UZS")
  toAmount     Decimal?        @db.Decimal(15, 2)
  toCurrency   String?
  rate         Decimal?        @db.Decimal(15, 6)
  category     String?
  description  String?
  debtId       String?
  recurringId  String?
  date         DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet          @relation("fromWallet", fields: [walletId], references: [id])
  toWallet     Wallet?         @relation("toWallet", fields: [toWalletId], references: [id])
  debt         Debt?           @relation(fields: [debtId], references: [id])
  recurring    RecurringRule?  @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([debtId])
  @@index([recurringId])
}

// Takrorlanuvchi kirim/chiqim. Birinchi yozuv qo'shilganda yaratiladi (count = 1),
// keyingilari nextDate kelganda processRecurring() orqali avtomatik qo'shiladi.
// n-takror sanasi har doim startDate dan hisoblanadi — oylik takror 31-sanada "siljib" qolmaydi.
model RecurringRule {
  id           String             @id @default(cuid())
  userId       String
  walletId     String
  type         TransactionType    // faqat INCOME yoki EXPENSE
  amount       Decimal            @db.Decimal(15, 2)
  currency     String
  category     String?
  description  String?
  frequency    RecurringFrequency
  startDate    DateTime
  count        Int                @default(1) // keyingi takror indeksi (startDate dan); tahrirda jadval qayta boshlansa 0
  nextDate     DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, nextDate])
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// Qarz. Qaytarilgan summa bog'langan tranzaksiyalardan hisoblanadi:
// LENT (men berdim):     boshlang'ich = DEBT_OUT, qaytarish = DEBT_IN
// BORROWED (men oldim):  boshlang'ich = DEBT_IN,  qaytarish = DEBT_OUT
model Debt {
  id           String        @id @default(cuid())
  userId       String
  type         DebtType
  person       String
  phone        String?
  amount       Decimal       @db.Decimal(15, 2)
  currency     String        @default("UZS")
  date         DateTime      @default(now())
  dueDate      DateTime?
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

enum DebtType {
  LENT
  BORROWED
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String?  // src/lib/category-icons.ts dagi kalit
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  category     String
  amount       Decimal  @db.Decimal(15, 2)
  currency     String   @default("UZS")
  month        Int
  year         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal  @db.Decimal(15, 2)
  currentAmount Decimal  @default(0) @db.Decimal(15, 2)
  currency      String   @default("UZS")
  deadline      DateTime?
  icon          String?
  color         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String   @unique
  code         String   @unique
  createdAt    DateTime @default(now())

  referrer     User     @relation("referrer", fields: [referrerId], references: [id])
  referred     User     @relation("referred", fields: [referredId], references: [id])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  DEBT_IN   // qarz olindi yoki qarz qaytarildi — hamyonga kiradi
  DEBT_OUT  // qarz berildi yoki qarz to'landi — hamyondan chiqadi
}
